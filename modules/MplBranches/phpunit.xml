<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.4/phpunit.xsd"
  bootstrap="../../tests/bootstrap.php"
  colors="true">
  <testsuites>
    <testsuite name="MplBranches">
      <directory suffix="Test.php">Tests</directory>
    </testsuite>
  </testsuites>
  <php>
    <server name="APP_ENV" value="TESTING" force="true"/>
    <server name="BCRYPT_ROUNDS" value="4" force="true"/>
    <server name="CACHE_DRIVER" value="array" force="true"/>
    <server name="DB_CONNECTION" value="sqlite" force="true"/>
    <server name="DB_DATABASE" value="modules/MplBranches/Tests/test.sqlite" force="true"/>
    <server name="DB_PREFIX" value="ns_" force="true"/>
    <server name="MAIL_MAILER" value="array" force="true"/>
    <server name="QUEUE_CONNECTION" value="sync" force="true"/>
    <server name="SESSION_DRIVER" value="array" force="true"/>
    <server name="TELESCOPE_ENABLED" value="FALSE" force="true"/>
    <server name="BROADCAST_DRIVER" value="log" force="true"/>
    <server name="SANCTUM_STATEFUL_DOMAINS" value="nexopos-v4.std" force="true"/>
    <server name="SESSION_DOMAIN" value="nexopos-v4.std" force="true"/>
    <server name="NS_VERSION" value="false" force="true"/>
  </php>
</phpunit>
